APP_NAME="Welcome Email AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
SESSION_DRIVER=file
CACHE_STORE=file

MAIL_MAILER=mailtrap
MAILTRAP_API_KEY=your_mailtrap_api_key
MAILTRAP_TEMPLATE_UUID=your_welcome_email_template_uuid
MAIL_FROM_ADDRESS=welcome@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Sandbox mode: set to true to preview emails in Mailtrap Sandbox inbox
# Set to false (or remove) to send real emails via Mailtrap transactional API
MAILTRAP_SANDBOX=true
MAILTRAP_INBOX_ID=your_sandbox_inbox_id

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
