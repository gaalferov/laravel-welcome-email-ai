APP_NAME="Welcome Email AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
SESSION_DRIVER=file
CACHE_STORE=file

MAIL_MAILER=mailtrap-sdk
MAILTRAP_HOST=send.api.mailtrap.io
MAILTRAP_API_KEY=your_mailtrap_api_key
MAILTRAP_TEMPLATE_UUID=your_welcome_email_template_uuid
MAIL_FROM_ADDRESS=welcome@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Set MAILTRAP_SANDBOX=true plus MAILTRAP_INBOX_ID to capture mail in a sandbox inbox
# instead of sending real email via the production transactional API.
MAILTRAP_SANDBOX=true
MAILTRAP_INBOX_ID=your_sandbox_inbox_id

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
